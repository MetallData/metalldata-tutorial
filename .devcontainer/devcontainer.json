{
    "name": "MetallData Tutorial",
    "build": {
        "dockerfile": "../docker/Dockerfile",
        "context": "..",
        // Keep in sync with /METALLDATA_REF (CI checks this).
        "args": { "METALLDATA_REF": "109bb0dd287821b1b77829545a22648af53eae98" }
    },
    "containerEnv": {
        "TUTORIAL_DATA": "${containerWorkspaceFolder}/data"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "charliermarsh.ruff"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/venv/bin/python"
            }
        }
    },
    "forwardPorts": [8888],
    "postCreateCommand": "python -m ipykernel install --user --name python3 --display-name 'Python 3 (metalldata)'"
}
